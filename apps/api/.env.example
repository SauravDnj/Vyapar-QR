# Server
PORT=4100
NODE_ENV=development

# Database (matches docker-compose.yml; local native MySQL uses the same values)
DATABASE_URL="mysql://root:password@localhost:3306/qrhub_dev"

# Redis (queue + rate-limit store)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_EXPIRES_IN="30d"

# S3 / MinIO (local dev uses MinIO; swap to AWS S3 or Cloudflare R2 in prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="qrhub-dev"
S3_ACCESS_KEY_ID="qrhub"
S3_SECRET_ACCESS_KEY="qrhub_dev_pw"
S3_FORCE_PATH_STYLE=true

# Razorpay (test mode) — leave blank to run with billing routes disabled
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
BILLING_GRACE_PERIOD_DAYS="7"

# Google Places API (New) — read-only live review pull, preferred over the
# Sheets sync below whenever a client has set a Google Place ID and this key
# is present. Leave blank to keep using Sheets sync only. Does not support
# posting replies (that needs the separate OAuth-based Business Profile API,
# a bigger, intentionally out-of-scope future phase — see docs/PROGRESS.md).
GOOGLE_PLACES_API_KEY=""

# Google Sheets service account — leave blank to disable sheet sync and
# feedback-to-sheet logging. Needs edit access (share the sheet(s) with this
# service account email) since it both reads synced reviews and appends
# private-feedback rows.
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Apple Wallet (loyalty card passes) — leave blank to disable "Add to Apple
# Wallet". Requires a paid Apple Developer Program membership, a Pass Type ID
# certificate + private key, and Apple's WWDR intermediate certificate.
APPLE_TEAM_ID=""
APPLE_PASS_TYPE_ID=""
APPLE_WWDR_CERT=""
APPLE_SIGNING_CERT=""
APPLE_SIGNING_KEY=""
APPLE_CERT_PASSWORD=""

# Google Wallet (loyalty card passes) — separate service account from
# GOOGLE_SERVICE_ACCOUNT_* above even if in the same GCP project (needs the
# wallet_object.issuer scope). Leave blank to disable "Add to Google Wallet".
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_SERVICE_ACCOUNT_PRIVATE_KEY=""

# MSG91 SMS (backup owner-alert channel — low ratings, new orders) — leave
# blank to disable. Uses MSG91's REST API directly, no SDK. Sent alongside
# (not instead of) the WhatsApp/email alerts above, independent of whether
# WhatsApp alerts are enabled.
MSG91_AUTH_KEY=""
MSG91_SENDER_ID=""

# WhatsApp Business (Meta Cloud API) — leave blank to disable low-rating
# feedback WhatsApp alerts (P11-01), the CRM's "Send WhatsApp"/"Request
# review" actions, and the AI chatbot (P12-01) — all share this one number.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Arbitrary string you choose — must match what you enter as the Meta app's
# webhook "Verify token" when subscribing this deployment's /whatsapp/webhook.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# Groq (OpenAI-compatible chat completions) — leave blank to disable the
# WhatsApp AI chatbot; inbound messages still get logged, just no auto-reply.
GROQ_API_KEY=""

# SMTP — leave blank to log emails instead of sending
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="QRHub <no-reply@qrhub.local>"

# Public URLs
ADMIN_APP_URL="http://localhost:3001"
LANDING_APP_URL="http://localhost:3002"
API_PUBLIC_URL="http://localhost:4100"

# Shared secret with apps/landing's /api/revalidate route, pinged on publish
REVALIDATE_SECRET="dev-revalidate-secret"

# CORS
CORS_ORIGINS="http://localhost:3001,http://localhost:3002"

# Vercel API (P3-01) — registers a client's custom domain on the apps/landing
# Vercel project once ownership is verified, so Vercel auto-provisions SSL
# for it. Leave blank to skip automatic registration (client can still be
# added manually in the Vercel dashboard). Token: Vercel account settings ->
# Tokens. Project ID: apps/landing's Vercel project settings -> General.
# Team ID only needed if the project lives under a Vercel team, not a
# personal account.
VERCEL_API_TOKEN=""
VERCEL_LANDING_PROJECT_ID=""
VERCEL_TEAM_ID=""
