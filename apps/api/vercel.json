{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @qrhub/types build && pnpm --filter api build",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/internal/cron/grace-period",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/internal/cron/lead-follow-up",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/internal/cron/booking-reminder",
      "schedule": "0 * * * *"
    },
    {
      "path": "/internal/cron/review-sync",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/internal/cron/weekly-digest",
      "schedule": "0 9 * * 1"
    }
  ]
}
