# Server
PORT=4100
NODE_ENV=development

# Database (local native MySQL server)
DATABASE_URL="mysql://root:Ethos%40123@localhost:3306/qrhub_dev"

# Redis (queue + rate-limit store)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_REFRESH_EXPIRES_IN="30d"

# S3 / MinIO (local dev uses MinIO; swap to AWS S3 or Cloudflare R2 in prod)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="qrhub-dev"
S3_ACCESS_KEY_ID="qrhub"
S3_SECRET_ACCESS_KEY="qrhub_dev_pw"
S3_FORCE_PATH_STYLE=true

# Razorpay (test mode) — leave blank to run with billing routes disabled
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
BILLING_GRACE_PERIOD_DAYS="7"

# Google Sheets (read-only service account) — leave blank to disable sheet sync
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# SMTP — leave blank to log emails instead of sending
# Ethereal test account (free, no signup) — used to live-verify email flows
# without real credentials. Inbox: https://ethereal.email/login
SMTP_HOST="smtp.ethereal.email"
SMTP_PORT="587"
SMTP_USER="gak4moigue6qnrwj@ethereal.email"
SMTP_PASSWORD="kqQ6rGY4CFJsBB1Kf3"
SMTP_FROM="QRHub <no-reply@qrhub.local>"

# Public URLs
ADMIN_APP_URL="http://localhost:3001"
LANDING_APP_URL="http://localhost:3002"
API_PUBLIC_URL="http://localhost:4100"
REVALIDATE_SECRET="dev-revalidate-secret"

# CORS
